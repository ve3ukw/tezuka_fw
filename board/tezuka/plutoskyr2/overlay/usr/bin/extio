#!/bin/sh
#
# extio: JP5 header (EXT_IO) lines as named inputs and outputs.
#
# Each header pin is set by the u-boot environment variable extio_pinNN
# (pin number, two digits), falling back to the defaults in /etc/extio.conf:
#
#   extio_pin03=out,relay,0    direction,name,boot level (outputs)
#   extio_pin05=in,pa_ready    inputs are read only
#   extio_pin07=off            not driven, not shown (also when unset)
#
# Edit through config.txt [EXTIO] on the USB drive, the Dashboard env editor
# or fw_setenv, then run "extio apply" (done at boot by S24extio). Names start
# with a letter and use letters, digits, _ and -. Several outputs may share a
# name: they switch together (one gpioset call) and take the boot level of
# the first of them. Each must drive its own load; never tie pins together.
#
#   extio apply             configure every pin from the settings
#   extio list              pin, volts, direction, name, value
#   extio get <name>        prints 0 or 1
#   extio set <name> 0|1    outputs only
#   extio has <name>        exit status 0 if <name> is a configured line
#   extio dump              "name dir pins value" per name, pins joined by +
#   extio config            [EXTIO] lines for config.txt
#   extio pins              header pin numbers
#
# Uses the libgpiod v1 tools (no GPIO sysfs). gpioget turns a line into an
# input, so output levels are kept in $LEVELS rather than read back; the zynq
# driver keeps an output's level after gpioset releases it.

CONF=/etc/extio.conf
RUN=/var/run/extio
LEVELS=$RUN/level

[ -r "$CONF" ] || { echo "extio: no $CONF" >&2; exit 1; }
. "$CONF"
: "${EXTIO_CHIP_LABEL:=zynq_gpio}"
: "${EXTIO_EMIO_BASE:=54}"

usage() {
	echo "Usage: $0 {apply|list|get <name>|set <name> 0|1|has <name>|dump|config|pins}" >&2
	exit 1
}

find_chip() {
	gpiodetect 2>/dev/null | sed -n "s/^\(gpiochip[0-9]*\) \[$EXTIO_CHIP_LABEL\].*/\1/p" | head -n 1
}

# pin_setting <NN>: the environment value, else the default, else off
pin_setting() {
	v=$(fw_printenv -n "extio_pin$1" 2>/dev/null)
	[ -n "$v" ] || eval "v=\${EXTIO_DEFAULT_pin$1:-off}"
	echo "$v" | tr -d ' \t\r'
}

apply() {
	chip=$(find_chip)
	[ -n "$chip" ] || { echo "extio: no $EXTIO_CHIP_LABEL gpiochip" >&2; exit 1; }
	rm -rf "$RUN"
	mkdir -p "$LEVELS"
	echo "$chip" > "$RUN/chip"
	: > "$RUN/table"
	for p in $EXTIO_PINS; do
		pin=${p%%:*}
		rest=${p#*:}
		off=$((EXTIO_EMIO_BASE + ${rest%%:*}))
		s=$(pin_setting "$pin")
		dir=$(echo "$s" | cut -d, -f1)
		name=$(echo "$s" | cut -s -d, -f2)
		level=$(echo "$s" | cut -s -d, -f3)
		[ -n "$name" ] || name="jp5_pin$pin"
		[ "$level" = 1 ] || level=0
		case "$dir" in
		in|out|off) ;;
		*) logger -t extio "pin$pin: bad direction '$dir', left off"; dir=off ;;
		esac
		if [ "$dir" != off ]; then
			if ! echo "$name" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*$'; then
				logger -t extio "pin$pin: bad name '$name', left off"; dir=off
			fi
			# only outputs may share a name; a group follows its first pin's level
			prev=$(awk -v n="$name" '$1 == n { print $2; exit }' "$RUN/table")
			if [ -n "$prev" ]; then
				if [ "$dir" = in ] || [ "$prev" = in ]; then
					logger -t extio "pin$pin: name '$name' already used (only outputs can share a name), left off"
					dir=off
				else
					level=$(cat "$LEVELS/$name")
				fi
			fi
		fi
		if [ "$dir" = out ]; then
			gpioset "$chip" "$off=$level" && echo "$level" > "$LEVELS/$name"
		else
			gpioget "$chip" "$off" > /dev/null
		fi
		[ "$dir" = off ] && continue
		echo "$name $dir $pin $off" >> "$RUN/table"
	done
	logger -t extio "applied: $(awk '!seen[$1]++ { printf "%s ", $1 }' "$RUN/table")"
}

# lookup <name>: sets L_DIR and L_OFFS (every line offset with that name)
lookup() {
	[ -r "$RUN/table" ] || return 1
	L_OFFS=$(awk -v n="$1" '$1 == n { printf "%s ", $4 }' "$RUN/table")
	[ -n "$L_OFFS" ] || return 1
	L_DIR=$(awk -v n="$1" '$1 == n { print $2; exit }' "$RUN/table")
}

get_value() {
	lookup "$1" || { echo "extio: no line named '$1'" >&2; return 1; }
	if [ "$L_DIR" = out ]; then
		cat "$LEVELS/$1"
	else
		gpioget "$(cat "$RUN/chip")" $L_OFFS
	fi
}

set_value() {
	lookup "$1" || { echo "extio: no line named '$1'" >&2; return 1; }
	[ "$L_DIR" = out ] || { echo "extio: '$1' is an input" >&2; return 1; }
	case "$2" in 0|1) ;; *) usage ;; esac
	args=""
	for o in $L_OFFS; do
		args="$args $o=$2"
	done
	gpioset "$(cat "$RUN/chip")" $args && echo "$2" > "$LEVELS/$1"
}

# dump: one line per name (pins of a group joined by +), one gpioget for all
# inputs, output levels from $LEVELS
dump() {
	[ -s "$RUN/table" ] || return 0
	ins=$(awk '$2 == "in" { printf "%s ", $4 }' "$RUN/table")
	vals=""
	[ -n "$ins" ] && vals=$(gpioget "$(cat "$RUN/chip")" $ins)
	awk '{ if (!($1 in pins)) { order[n++] = $1; dir[$1] = $2; pins[$1] = $3 }
	       else pins[$1] = pins[$1] "+" $3 }
	     END { for (i = 0; i < n; i++) print order[i], dir[order[i]], pins[order[i]] }' "$RUN/table" |
	while read -r name dir pins; do
		if [ "$dir" = out ]; then
			v=$(cat "$LEVELS/$name")
		else
			set -- $vals
			v=$1
			shift
			vals="$*"
		fi
		echo "$name $dir $pins $v"
	done
}

list() {
	printf "%-4s %-5s %-4s %-16s %s\n" PIN VOLTS DIR NAME VALUE
	values=$(dump)
	for p in $EXTIO_PINS; do
		pin=${p%%:*}
		volts=${p##*:}
		line=$(echo "$values" | awk -v p="$pin" '{ n = split($3, a, "+"); for (i = 1; i <= n; i++) if (a[i] == p) print }')
		if [ -n "$line" ]; then
			set -- $line
			printf "%-4s %-5s %-4s %-16s %s\n" "$pin" "$volts" "$2" "$1" "$4"
		else
			printf "%-4s %-5s %-4s %-16s %s\n" "$pin" "$volts" off - -
		fi
	done
}

config() {
	echo "# JP5 header: pinNN = in|out|off,name,level (boot level, outputs only)"
	echo "# Pin 21 is 3.3 V, all other pins 1.8 V. Empty = off."
	echo "# Pin 21 jumpered to pin 23 selects the 40 MHz clock: out,clk_sel,1"
	echo "# (1 = onboard, 0 = external). Otherwise leave pin 21 off."
	echo "# Names: letter first, then letters, digits, _ or -. A line named 'ptt'"
	echo "# follows Tezuka's TX detection (1 s polling, not for timing-critical keying)."
	echo "# Outputs sharing a name switch together (each to its own load, never tie pins)."
	for p in $EXTIO_PINS; do
		echo "pin${p%%:*} = $(pin_setting "${p%%:*}")"
	done
}

case "$1" in
apply)  apply ;;
list)   list ;;
get)    [ -n "$2" ] || usage; get_value "$2" ;;
set)    [ -n "$3" ] || usage; set_value "$2" "$3" ;;
has)    [ -n "$2" ] || usage; lookup "$2" ;;
dump)   dump ;;
config) config ;;
pins)   for p in $EXTIO_PINS; do echo "${p%%:*}"; done ;;
*)      usage ;;
esac
